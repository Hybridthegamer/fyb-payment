rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Students can read their own pending payment document
    // Document ID = Firebase Auth UID
    match /pendingPayments/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Students can read their own completed payment record
    match /payments/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Block everything else from client access
    // Backend uses Admin SDK and bypasses these rules
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
