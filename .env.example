FOSSAPAY_SECRET_KEY=fp_live_sk_your_key_here
FOSSAPAY_WEBHOOK_SECRET=your_webhook_secret_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_WEBHOOK=https://script.google.com/macros/s/xxx/exec

# ── One-time setup (used only by /api/setup-account) ──────────────────────────
SETUP_SECRET=              # Strong random string — protects the setup endpoint
ORGANIZER_EMAIL=           # Email address to register the organizer FossaPay account under
ORGANIZER_PHONE=           # Organizer phone number in +234 format (e.g. +2348012345678)
ADMIN_EMAIL=               # Your Google account email — only this email can access /admin
